diff --git a/test/csv_builder_test.dart b/test/csv_builder_test.dart
new file mode 100644
index 0000000..1e9b8dc
--- /dev/null
+++ b/test/csv_builder_test.dart
@@ -0,0 +1,38 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:qr_barcode_toolkit/utils/csv_builder.dart';
+
+void main() {
+  group('CsvBuilder', () {
+    test('plain rows use CRLF line endings', () {
+      expect(
+        CsvBuilder.build(['a', 'b'], [['1', '2']]),
+        'a,b\r\n1,2\r\n',
+      );
+    });
+
+    test('empty cell stays empty', () {
+      expect(CsvBuilder.build(['h'], [['']]), 'h\r\n\r\n');
+    });
+
+    test('commas, quotes and newlines are quoted and escaped', () {
+      expect(CsvBuilder.build(['h'], [['x,y']]), 'h\r\n"x,y"\r\n');
+      expect(CsvBuilder.build(['h'], [['say "hi"']]), 'h\r\n"say ""hi"""\r\n');
+      expect(CsvBuilder.build(['h'], [['a\nb']]), 'h\r\n"a\nb"\r\n');
+    });
+
+    test('formula-looking cells get a leading apostrophe (CSV injection)', () {
+      expect(
+        CsvBuilder.build(['h'], [['=HYPERLINK("http://evil","x")']]),
+        "h\r\n\"'=HYPERLINK(\"\"http://evil\"\",\"\"x\"\")\"\r\n",
+      );
+      expect(
+        CsvBuilder.build(['h'], [['+1'], ['-1'], ['@x'], ['\tx']]),
+        "h\r\n'+1\r\n'-1\r\n'@x\r\n'\tx\r\n",
+      );
+    });
+
+    test('a cell with = in the middle is left alone', () {
+      expect(CsvBuilder.build(['h'], [['a=b']]), 'h\r\na=b\r\n');
+    });
+  });
+}
diff --git a/test/history_service_test.dart b/test/history_service_test.dart
new file mode 100644
index 0000000..fa2f457
--- /dev/null
+++ b/test/history_service_test.dart
@@ -0,0 +1,149 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:qr_barcode_toolkit/models/history_item.dart';
+import 'package:qr_barcode_toolkit/services/history_service.dart';
+import 'package:qr_barcode_toolkit/services/pro_service.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+
+final _base = DateTime(2026, 1, 1);
+
+HistoryItem _item(
+  String id,
+  String value,
+  int minute, {
+  String type = 'scan',
+  bool favorite = false,
+}) =>
+    HistoryItem(
+      id: id,
+      type: type,
+      value: value,
+      timestamp: _base.add(Duration(minutes: minute)),
+      favorite: favorite,
+    );
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+
+  group('HistoryService.withAdded (pure logic)', () {
+    test('adds a new item', () {
+      final out = HistoryService.withAdded([], _item('a', 'one', 0), isPro: false);
+      expect(out.map((i) => i.id), ['a']);
+    });
+
+    test('same type and value replaces the old entry and keeps its favorite flag', () {
+      final existing = [_item('old', 'same', 0, favorite: true), _item('x', 'other', 1)];
+      final out = HistoryService.withAdded(
+        existing,
+        _item('new', 'same', 5),
+        isPro: false,
+      );
+      expect(out.where((i) => i.value == 'same').length, 1);
+      final kept = out.firstWhere((i) => i.value == 'same');
+      expect(kept.id, 'new');
+      expect(kept.favorite, isTrue);
+      expect(kept.timestamp, _base.add(const Duration(minutes: 5)));
+    });
+
+    test('same value but different type is NOT treated as a duplicate', () {
+      final existing = [_item('s', 'same', 0, type: 'scan')];
+      final out = HistoryService.withAdded(
+        existing,
+        _item('g', 'same', 1, type: 'generate'),
+        isPro: false,
+      );
+      expect(out.length, 2);
+    });
+
+    test('over the cap drops the oldest non-favorite, never a favorite', () {
+      final existing = [
+        _item('A', 'a', 0, favorite: true), // oldest, but a favorite
+        _item('B', 'b', 1),
+        _item('C', 'c', 2),
+      ];
+      final out = HistoryService.withAdded(
+        existing,
+        _item('D', 'd', 3),
+        isPro: false,
+        limit: 3,
+      );
+      expect(out.map((i) => i.id).toSet(), {'A', 'C', 'D'});
+    });
+
+    test('the item being added is never dropped, even if everything else is a favorite', () {
+      final existing = [
+        _item('A', 'a', 0, favorite: true),
+        _item('B', 'b', 1, favorite: true),
+        _item('C', 'c', 2, favorite: true),
+      ];
+      final out = HistoryService.withAdded(
+        existing,
+        _item('D', 'd', 3),
+        isPro: false,
+        limit: 3,
+      );
+      expect(out.map((i) => i.id).toSet(), {'A', 'B', 'C', 'D'});
+    });
+
+    test('Pro users are not capped', () {
+      var list = <HistoryItem>[];
+      for (var i = 0; i < 60; i++) {
+        list = HistoryService.withAdded(list, _item('id$i', 'v$i', i), isPro: true);
+      }
+      expect(list.length, 60);
+    });
+  });
+
+  group('HistoryService (storage)', () {
+    setUp(() {
+      SharedPreferences.setMockInitialValues({});
+      ProService.isPro.value = false;
+    });
+
+    test('many adds started at the same time are all kept (no lost writes)', () async {
+      final service = HistoryService();
+      await Future.wait([
+        for (var i = 0; i < 30; i++) service.add(_item('id$i', 'code$i', i)),
+      ]);
+      final all = await service.getAll();
+      expect(all.length, 30);
+    });
+
+    test('getAll returns newest first', () async {
+      final service = HistoryService();
+      await service.add(_item('old', 'a', 0));
+      await service.add(_item('new', 'b', 10));
+      final all = await service.getAll();
+      expect(all.map((i) => i.id), ['new', 'old']);
+    });
+
+    test('favorite survives the free cap through the real add path', () async {
+      final service = HistoryService();
+      await service.add(_item('fav', 'favorite-value', 0, favorite: true));
+      for (var i = 1; i <= HistoryService.freeTierLimit + 5; i++) {
+        await service.add(_item('id$i', 'v$i', i));
+      }
+      final all = await service.getAll();
+      expect(all.any((i) => i.id == 'fav'), isTrue);
+      expect(all.length, HistoryService.freeTierLimit);
+    });
+
+    test('setFavorite and delete persist', () async {
+      final service = HistoryService();
+      await service.add(_item('a', 'a', 0));
+      await service.add(_item('b', 'b', 1));
+      await service.setFavorite('a', true);
+      await service.delete('b');
+      final all = await service.getAll();
+      expect(all.length, 1);
+      expect(all.single.id, 'a');
+      expect(all.single.favorite, isTrue);
+    });
+
+    test('clear empties the history', () async {
+      final service = HistoryService();
+      await service.add(_item('a', 'a', 0));
+      await service.clear();
+      expect(await service.getAll(), isEmpty);
+    });
+  });
+}
diff --git a/test/scan_content_test.dart b/test/scan_content_test.dart
new file mode 100644
index 0000000..044ea06
--- /dev/null
+++ b/test/scan_content_test.dart
@@ -0,0 +1,156 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:qr_barcode_toolkit/utils/scan_content.dart';
+
+void main() {
+  group('ScanContent.parse — links and plain text', () {
+    test('https link', () {
+      final c = ScanContent.parse('https://example.com/a?b=1');
+      expect(c.kind, ScanKind.url);
+      expect(c.uri!.host, 'example.com');
+    });
+
+    test('surrounding whitespace is ignored but raw is preserved', () {
+      const raw = '  https://example.com  ';
+      final c = ScanContent.parse(raw);
+      expect(c.kind, ScanKind.url);
+      expect(c.raw, raw);
+    });
+
+    test('non-web schemes are plain text, never links', () {
+      expect(ScanContent.parse('javascript:alert(1)').kind, ScanKind.text);
+      expect(ScanContent.parse('file:///etc/passwd').kind, ScanKind.text);
+    });
+
+    test('ordinary text', () {
+      expect(ScanContent.parse('hello world').kind, ScanKind.text);
+    });
+  });
+
+  group('ScanContent.parse — contact-style codes', () {
+    test('tel', () {
+      final c = ScanContent.parse('tel:+911234567890');
+      expect(c.kind, ScanKind.phone);
+      expect(c.uri!.scheme, 'tel');
+    });
+
+    test('mailto and a bare email address', () {
+      expect(ScanContent.parse('mailto:a@b.com').kind, ScanKind.email);
+      final bare = ScanContent.parse('a@b.com');
+      expect(bare.kind, ScanKind.email);
+      expect(bare.uri!.scheme, 'mailto');
+    });
+
+    test('SMSTO format becomes an sms uri', () {
+      final c = ScanContent.parse('SMSTO:+123:Hi there');
+      expect(c.kind, ScanKind.sms);
+      expect(c.uri!.scheme, 'sms');
+    });
+
+    test('geo', () {
+      expect(ScanContent.parse('geo:12.34,56.78').kind, ScanKind.geo);
+    });
+  });
+
+  group('ScanContent.parse — Wi-Fi', () {
+    test('reads ssid, password, security; handles escaped semicolon', () {
+      final c = ScanContent.parse(r'WIFI:T:WPA;S:MyNet;P:pass\;word;H:false;;');
+      expect(c.kind, ScanKind.wifi);
+      expect(c.wifi!.ssid, 'MyNet');
+      expect(c.wifi!.password, 'pass;word');
+      expect(c.wifi!.security, 'WPA');
+      expect(c.wifi!.hidden, isFalse);
+      expect(c.wifi!.hasPassword, isTrue);
+    });
+
+    test('open network', () {
+      final c = ScanContent.parse('WIFI:T:nopass;S:Cafe;;');
+      expect(c.kind, ScanKind.wifi);
+      expect(c.wifi!.hasPassword, isFalse);
+    });
+
+    test('without an ssid it is not treated as Wi-Fi', () {
+      expect(ScanContent.parse('WIFI:T:WPA;P:x;;').kind, ScanKind.text);
+    });
+  });
+
+  group('ScanContent.parse — products', () {
+    test('numeric product barcode only when the caller says it is one', () {
+      expect(ScanContent.parse('8901234567890', isProductBarcode: true).kind,
+          ScanKind.product);
+      expect(ScanContent.parse('8901234567890').kind, ScanKind.text);
+    });
+  });
+
+  group('ScanContent.parse — UPI payments', () {
+    test('pay link with all fields', () {
+      final c = ScanContent.parse(
+        'upi://pay?pa=shop@bank&pn=Shop%20Name&am=499.00&cu=INR&tn=Order',
+      );
+      expect(c.kind, ScanKind.payment);
+      final p = c.payment!;
+      expect(p.scheme, 'upi');
+      expect(p.payeeId, 'shop@bank');
+      expect(p.payeeName, 'Shop Name');
+      expect(p.amount, '499.00');
+      expect(p.currency, 'INR');
+      expect(p.note, 'Order');
+      expect(p.isCollectRequest, isFalse);
+      expect(p.amountLabel, '\u20B9499.00');
+      expect(c.uri, isNotNull);
+    });
+
+    test('scheme is case-insensitive', () {
+      expect(ScanContent.parse('UPI://pay?pa=a@b').kind, ScanKind.payment);
+    });
+
+    test('collect request is flagged and the warning says so', () {
+      final c = ScanContent.parse('upi://collect?pa=a@b&pn=X');
+      expect(c.kind, ScanKind.payment);
+      expect(c.payment!.isCollectRequest, isTrue);
+      expect(c.payment!.warning, startsWith('Someone is asking you to pay.'));
+    });
+
+    test('a malformed amount is ignored, not trusted', () {
+      final p = ScanContent.parse('upi://pay?pa=a@b&am=abc').payment!;
+      expect(p.amount, isNull);
+      expect(p.amountLabel, isNull);
+    });
+
+    test('currency defaults to INR when missing', () {
+      expect(ScanContent.parse('upi://pay?pa=a@b').payment!.currency, 'INR');
+    });
+
+    test('unknown upi action is not a payment', () {
+      expect(ScanContent.parse('upi://mandate?pa=a@b').kind, ScanKind.text);
+    });
+  });
+
+  group('ScanContent.parse — EMVCo merchant QR', () {
+    // Tags: 00=01, 01=11, 53=356 (INR), 54=100.00, 58=IN, 59=Shop, 60=Delhi, 63=CRC.
+    const emv = '00020101021153033565406100.005802IN5904Shop6005Delhi6304ABCD';
+
+    test('reads merchant, city, amount and currency', () {
+      final c = ScanContent.parse(emv);
+      expect(c.kind, ScanKind.payment);
+      final p = c.payment!;
+      expect(p.scheme, 'emv');
+      expect(p.payeeName, 'Shop');
+      expect(p.place, 'Delhi');
+      expect(p.amount, '100.00');
+      expect(p.currency, 'INR');
+      expect(p.amountLabel, '\u20B9100.00');
+      expect(c.uri, isNull);
+    });
+
+    test('without merchant name or country it is not a payment', () {
+      expect(ScanContent.parse('0002010102116304ABCD').kind, ScanKind.text);
+    });
+
+    test('without the CRC field it is not a payment', () {
+      expect(
+        ScanContent.parse('00020101021153033565802IN5904Shop').kind,
+        ScanKind.text,
+      );
+    });
+  });
+}
