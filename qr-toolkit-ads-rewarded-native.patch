diff --git a/lib/services/rewarded_ad_service.dart b/lib/services/rewarded_ad_service.dart
new file mode 100644
index 0000000..df520ae
--- /dev/null
+++ b/lib/services/rewarded_ad_service.dart
@@ -0,0 +1,119 @@
+import 'dart:async';
+import 'dart:math' as math;
+import 'package:flutter/foundation.dart';
+import 'package:google_mobile_ads/google_mobile_ads.dart';
+import 'ad_service.dart';
+import 'pro_service.dart';
+
+/// Loads one rewarded ad in the background so it is ready when the user
+/// chooses "Watch a short ad to unlock". Rewarded ads only ever play when the
+/// user asks for them, which is why they are the least intrusive format.
+class RewardedAdService {
+  /// True while a fresh ad is loaded and ready to show.
+  static final ValueNotifier<bool> ready = ValueNotifier(false);
+
+  static RewardedAd? _ad;
+  static DateTime? _loadedAt;
+  static bool _loading = false;
+  static int _failures = 0;
+  static Timer? _retryTimer;
+
+  static const _maxRetries = 4;
+
+  /// AdMob stops serving a cached rewarded ad after about an hour, so an ad
+  /// older than this is treated as not available.
+  static const _maxAge = Duration(minutes: 50);
+
+  static bool get isAvailable {
+    final loadedAt = _loadedAt;
+    return _ad != null &&
+        loadedAt != null &&
+        DateTime.now().difference(loadedAt) < _maxAge;
+  }
+
+  /// Safe to call any time; does nothing unless ads are ready, the user is
+  /// not Pro, and no ad is already loaded or loading.
+  static void preload() {
+    if (_loading || isAvailable) return;
+    if (!AdService.adsReady.value || ProService.isPro.value) return;
+
+    _discard(); // drop a stale ad, if any
+    _loading = true;
+    RewardedAd.load(
+      adUnitId: AdService.rewardedUnitId,
+      request: const AdRequest(),
+      rewardedAdLoadCallback: RewardedAdLoadCallback(
+        onAdLoaded: (ad) {
+          _loading = false;
+          _failures = 0;
+          _ad = ad;
+          _loadedAt = DateTime.now();
+          ready.value = true;
+        },
+        onAdFailedToLoad: (error) {
+          _loading = false;
+          _failures++;
+          ready.value = false;
+          _scheduleRetry();
+        },
+      ),
+    );
+  }
+
+  /// 30s, 60s, 120s, 240s, then stop. Another preload happens after each ad
+  /// is shown, so one failed load never disables rewarded ads for good.
+  static void _scheduleRetry() {
+    if (_failures > _maxRetries) return;
+    final seconds = math.min(30 * (1 << (_failures - 1)), 300);
+    _retryTimer?.cancel();
+    _retryTimer = Timer(Duration(seconds: seconds), preload);
+  }
+
+  static void _discard() {
+    _ad?.dispose();
+    _ad = null;
+    _loadedAt = null;
+    ready.value = false;
+  }
+
+  /// Shows the ad and returns true only if the user earned the reward
+  /// (watched it to the end). Returns false if no ad is available, it failed
+  /// to show, or the user closed it early.
+  static Future<bool> showAndWait() async {
+    final ad = _ad;
+    if (ad == null || !isAvailable) {
+      _discard();
+      preload();
+      return false;
+    }
+    // The ad is single use: take it out before showing.
+    _ad = null;
+    _loadedAt = null;
+    ready.value = false;
+
+    final done = Completer<bool>();
+    var earned = false;
+
+    ad.fullScreenContentCallback = FullScreenContentCallback(
+      onAdDismissedFullScreenContent: (ad) {
+        ad.dispose();
+        if (!done.isCompleted) done.complete(earned);
+        preload();
+      },
+      onAdFailedToShowFullScreenContent: (ad, error) {
+        ad.dispose();
+        if (!done.isCompleted) done.complete(false);
+        preload();
+      },
+    );
+
+    try {
+      await ad.show(onUserEarnedReward: (adWithoutView, reward) => earned = true);
+    } catch (_) {
+      ad.dispose();
+      if (!done.isCompleted) done.complete(false);
+      preload();
+    }
+    return done.future;
+  }
+}
diff --git a/lib/utils/ad_layout.dart b/lib/utils/ad_layout.dart
new file mode 100644
index 0000000..2a9e890
--- /dev/null
+++ b/lib/utils/ad_layout.dart
@@ -0,0 +1,33 @@
+import 'dart:math' as math;
+
+/// Works out where native ads go inside a list of real items, so the list
+/// builder can ask "is this row an ad, and if not, which item is it?".
+///
+/// Ads go between items only (never first, never last), at most [maxAds] per
+/// list, and only once there are more than [every] items.
+class AdLayout {
+  /// How many ad rows a list of [itemCount] items gets.
+  static int adSlots(int itemCount, {int every = 8, int maxAds = 2}) {
+    if (itemCount <= every) return 0;
+    return math.min(maxAds, (itemCount - 1) ~/ every);
+  }
+
+  /// Total rows: real items plus ad rows.
+  static int totalCount(int itemCount, {int every = 8, int maxAds = 2}) =>
+      itemCount + adSlots(itemCount, every: every, maxAds: maxAds);
+
+  /// True when row [index] is an ad row.
+  static bool isAdIndex(int index, int itemCount, {int every = 8, int maxAds = 2}) {
+    final slots = adSlots(itemCount, every: every, maxAds: maxAds);
+    if (slots == 0) return false;
+    final group = every + 1;
+    return index % group == every && index ~/ group < slots;
+  }
+
+  /// For a row that is not an ad, the index of the real item it shows.
+  static int itemIndex(int index, int itemCount, {int every = 8, int maxAds = 2}) {
+    final slots = adSlots(itemCount, every: every, maxAds: maxAds);
+    final adsBefore = math.min(index ~/ (every + 1), slots);
+    return index - adsBefore;
+  }
+}
